<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Auftragsabwicklung" targetNamespace="http://digistrat/bpmn"
  exporter="digistrat" exporterVersion="1.0">
  <bpmn:collaboration id="Collab">
    <bpmn:participant id="Participant" name="Auftragsabwicklung" processRef="Process_Auftragsabwicklung" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Auftragsabwicklung" name="Auftragsabwicklung" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="Lane_0" name="Vertrieb"><bpmn:flowNodeRef>N1</bpmn:flowNodeRef><bpmn:flowNodeRef>N2</bpmn:flowNodeRef><bpmn:flowNodeRef>N5</bpmn:flowNodeRef><bpmn:flowNodeRef>N7</bpmn:flowNodeRef><bpmn:flowNodeRef>N8</bpmn:flowNodeRef><bpmn:flowNodeRef>N11</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_1" name="Konstruktion"><bpmn:flowNodeRef>N3</bpmn:flowNodeRef><bpmn:flowNodeRef>N4</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_2" name="Arbeitsvorbereitung"><bpmn:flowNodeRef>N6</bpmn:flowNodeRef><bpmn:flowNodeRef>N9</bpmn:flowNodeRef><bpmn:flowNodeRef>N10</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="N1" name="Anfrage eingegangen"><bpmn:documentation>Outlook | E-Mail</bpmn:documentation></bpmn:startEvent>
    <bpmn:task id="N2" name="Anfrage erfassen"><bpmn:documentation>Excel | Excel | Anfrageliste in Excel</bpmn:documentation></bpmn:task>
    <bpmn:task id="N3" name="Technische Klärung"><bpmn:documentation>CAD | E-Mail | Rückfragen per Mail</bpmn:documentation></bpmn:task>
    <bpmn:exclusiveGateway id="N4" name="Machbar?"><bpmn:documentation>Mündlich/Telefon</bpmn:documentation></bpmn:exclusiveGateway>
    <bpmn:task id="N5" name="Kalkulation erstellen"><bpmn:documentation>Excel | Excel | Kalkulationsmappe</bpmn:documentation></bpmn:task>
    <bpmn:task id="N6" name="Liefertermin anfragen"><bpmn:documentation>ERP | Mündlich/Telefon | Telefonische Abfrage</bpmn:documentation></bpmn:task>
    <bpmn:task id="N7" name="Angebot versenden"><bpmn:documentation>Word | E-Mail</bpmn:documentation></bpmn:task>
    <bpmn:task id="N8" name="Auftrag im ERP anlegen"><bpmn:documentation>ERP | Digital integriert | Abtippen aus Excel</bpmn:documentation></bpmn:task>
    <bpmn:task id="N9" name="Fertigungspapiere drucken"><bpmn:documentation>ERP | Papier | Laufkarte</bpmn:documentation></bpmn:task>
    <bpmn:endEvent id="N10" name="Auftrag freigegeben"><bpmn:documentation>ERP | Digital integriert</bpmn:documentation></bpmn:endEvent>
    <bpmn:endEvent id="N11" name="Absage an Kunden"><bpmn:documentation>Outlook | E-Mail</bpmn:documentation></bpmn:endEvent>
    <bpmn:sequenceFlow id="F1_2" sourceRef="N1" targetRef="N2" name="Medienbruch" />
    <bpmn:sequenceFlow id="F2_3" sourceRef="N2" targetRef="N3" name="Medienbruch" />
    <bpmn:sequenceFlow id="F3_4" sourceRef="N3" targetRef="N4" />
    <bpmn:sequenceFlow id="F4_5" sourceRef="N4" targetRef="N5" />
    <bpmn:sequenceFlow id="F4_11" sourceRef="N4" targetRef="N11" />
    <bpmn:sequenceFlow id="F5_6" sourceRef="N5" targetRef="N6" name="Medienbruch" />
    <bpmn:sequenceFlow id="F6_7" sourceRef="N6" targetRef="N7" name="Medienbruch" />
    <bpmn:sequenceFlow id="F7_8" sourceRef="N7" targetRef="N8" name="Medienbruch" />
    <bpmn:sequenceFlow id="F8_9" sourceRef="N8" targetRef="N9" name="Medienbruch" />
    <bpmn:sequenceFlow id="F9_10" sourceRef="N9" targetRef="N10" name="Medienbruch" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collab">
      <bpmndi:BPMNShape id="Participant_di" bpmnElement="Participant" isHorizontal="true"><dc:Bounds x="60" y="0" width="1860" height="420" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_2_di" bpmnElement="Lane_2" isHorizontal="true"><dc:Bounds x="90" y="280" width="1830" height="140" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_1_di" bpmnElement="Lane_1" isHorizontal="true"><dc:Bounds x="90" y="140" width="1830" height="140" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_0_di" bpmnElement="Lane_0" isHorizontal="true"><dc:Bounds x="90" y="0" width="1830" height="140" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N1_di" bpmnElement="N1"><dc:Bounds x="247" y="52" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N2_di" bpmnElement="N2"><dc:Bounds x="375" y="35" width="120" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N3_di" bpmnElement="N3"><dc:Bounds x="545" y="175" width="120" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N4_di" bpmnElement="N4"><dc:Bounds x="750" y="185" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N5_di" bpmnElement="N5"><dc:Bounds x="885" y="35" width="120" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N6_di" bpmnElement="N6"><dc:Bounds x="1055" y="315" width="120" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N7_di" bpmnElement="N7"><dc:Bounds x="1225" y="35" width="120" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N8_di" bpmnElement="N8"><dc:Bounds x="1395" y="35" width="120" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N9_di" bpmnElement="N9"><dc:Bounds x="1565" y="315" width="120" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N10_di" bpmnElement="N10"><dc:Bounds x="1777" y="332" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N11_di" bpmnElement="N11"><dc:Bounds x="927" y="72" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_2_di" bpmnElement="F1_2"><di:waypoint x="283" y="70" /><di:waypoint x="375" y="70" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_3_di" bpmnElement="F2_3"><di:waypoint x="495" y="70" /><di:waypoint x="520" y="70" /><di:waypoint x="520" y="210" /><di:waypoint x="545" y="210" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_4_di" bpmnElement="F3_4"><di:waypoint x="665" y="210" /><di:waypoint x="750" y="210" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_5_di" bpmnElement="F4_5"><di:waypoint x="800" y="210" /><di:waypoint x="842" y="210" /><di:waypoint x="842" y="70" /><di:waypoint x="885" y="70" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_11_di" bpmnElement="F4_11"><di:waypoint x="800" y="210" /><di:waypoint x="864" y="210" /><di:waypoint x="864" y="90" /><di:waypoint x="927" y="90" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_6_di" bpmnElement="F5_6"><di:waypoint x="1005" y="70" /><di:waypoint x="1030" y="70" /><di:waypoint x="1030" y="350" /><di:waypoint x="1055" y="350" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_7_di" bpmnElement="F6_7"><di:waypoint x="1175" y="350" /><di:waypoint x="1200" y="350" /><di:waypoint x="1200" y="70" /><di:waypoint x="1225" y="70" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_8_di" bpmnElement="F7_8"><di:waypoint x="1345" y="70" /><di:waypoint x="1395" y="70" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_9_di" bpmnElement="F8_9"><di:waypoint x="1515" y="70" /><di:waypoint x="1540" y="70" /><di:waypoint x="1540" y="350" /><di:waypoint x="1565" y="350" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_10_di" bpmnElement="F9_10"><di:waypoint x="1685" y="350" /><di:waypoint x="1777" y="350" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
